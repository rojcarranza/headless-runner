<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.headless-runner.verify</string>
  <key>ProgramArguments</key>
  <array><string>/bin/bash</string><string>@ROOT@/verify.sh</string><string>--after-restart</string></array>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>@HOME@/Library/Logs/headless-runner-verify.log</string>
  <key>StandardErrorPath</key><string>@HOME@/Library/Logs/headless-runner-verify.log</string>
</dict>
</plist>
