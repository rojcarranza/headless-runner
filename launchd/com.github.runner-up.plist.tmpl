<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.github.runner-up</string>
  <key>ProgramArguments</key>
  <array><string>@RUNNER_UP@</string><string>serve</string></array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/run/current-system/sw/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <!-- Stop only the coordinator: running jobs carry on. -->
  <key>AbandonProcessGroup</key><true/>
  <key>StandardOutPath</key><string>@HOME@/Library/Logs/runner-up.log</string>
  <key>StandardErrorPath</key><string>@HOME@/Library/Logs/runner-up.log</string>
</dict>
</plist>
