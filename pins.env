# Versions the scripts read. Change one here and nowhere else.
# Xcode 27.1 or later, from the App Store (id 497799835)
XCODE_APP_ID=497799835
XCODE_MIN=27.1
# headless, runner-up and no-mistakes are not pinned here: the machine flake
# installs them, so machine/flake.nix and machine/flake.lock pin all three
# (change both together; see AGENTS.md). The headless scripts the machine stage
# runs are taken from the commit flake.lock holds.
# Claude Code is not pinned: the claude-code stage installs Anthropic's native
# build, which keeps itself up to date, as Infinitary needs a recent one.
